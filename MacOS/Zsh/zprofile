
eval "$(/opt/homebrew/bin/brew shellenv zsh)"

# Added by OrbStack: command-line tools and integration
# This won't be added again if you remove it.
source ~/.orbstack/shell/init.zsh 2>/dev/null || :

# PATH / fpath 自动去重，防止重复条目累积
# （之前 ~/.orbstack/bin 就在 PATH 里出现过两次）
typeset -U path PATH fpath FPATH

# JAVA_HOME —— 当前是 Temurin JDK 25
# 判断成功才 export：卸载 JDK 后 java_home 会往 stderr 报错，
# 每开一个窗口刷一次，且 JAVA_HOME 会被设成空字符串
if _jh=$(/usr/libexec/java_home 2>/dev/null); then
  export JAVA_HOME=$_jh
fi
unset _jh
